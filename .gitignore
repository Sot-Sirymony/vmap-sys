# Dependencies
node_modules/

# Build output
frontend/dist/
backend/target/

# Frontend tooling caches
.vite/
*.tsbuildinfo

# Runtime data (pre-import Excel backup snapshots, BRD C-7)
backend/data/
data/backup/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Data import/export working files (per CLAUDE.md: don't commit workbook exports/backups)
data/export/
data/backup/

# Local DB credentials (never commit).
# Matched by filename rather than by path, so the file stays ignored if it is
# moved or copied to another folder.
local_db.md
**/local_db.md

# Google Stitch MCP API key (never commit).
google_stitch.md
**/google_stitch.md

# Production connection details (never commit).
# Holds the Render Key Value external URL, which embeds its password — unlike
# the internal URL, that string is a live credential for a service now reachable
# from outside Render. Matched by filename as well as by path, so it stays
# ignored if the file is moved or copied.
production_env.md
**/production_env.md

# Database dumps (never commit).
# The region migration runbook writes one of these into the repo root, and a
# dump is a complete copy of production — every user row and every password
# hash. Matched by extension so a dump cannot be committed by accident wherever
# it is written. Deliberately NOT *.sql: the Flyway migrations are .sql files
# and must stay tracked.
*.dump
*.backup
*.sql.gz
*.sql.zst
