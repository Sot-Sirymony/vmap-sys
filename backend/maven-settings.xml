<?xml version="1.0" encoding="UTF-8"?>
<!--
  V10 (SEC-03-01, SEC-03-02): every dependency comes from Maven Central only.

  Some libraries' own POM files list extra repositories (a Gradle repository,
  an Amazon S3 bucket, GitHub Packages), and Maven would otherwise try them
  too. Each extra source is another place a look-alike package could be
  planted (dependency confusion). Used by the Dockerfile and CI with `mvn -s`.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>central</id>
      <name>Maven Central for every repository</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
